<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst build only. iOS uses Tether.entitlements. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- PTP/IP and HTTP to Wi-Fi cameras, FTP export to your own server. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- FTP receiver (port 2121, passive 40000-40100) and PTP/IP cameras that connect in. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- USB cameras through ImageCaptureCore. -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- Export to Photos. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- Export folders, catalogs and looks picked in the open panel, kept across launches. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
